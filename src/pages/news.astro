---
import BaseLayout from '../layouts/BaseLayout.astro';
import flywheelSources from '../data/flywheel-news.json';
import hunchSources from '../data/hunch-news.json';
import potableWaterSources from '../data/potable-water-news.json';
import { withBase } from '../utils/paths';

const topics = [
  {
    number: '01',
    title: 'Orion Flywheel Exercise Device',
    eyebrow: 'Artemis II · Flight hardware',
    description:
      'The engineering, testing, people, and in-flight public record behind Orion\'s compact exercise system.',
    href: '/news/flywheel/',
    count: flywheelSources.length,
    coverage: 'Development through Artemis II flight',
  },
  {
    number: '02',
    title: 'NASA HUNCH',
    eyebrow: 'Student hardware · 2018-2021',
    description:
      'A tightly bounded four-year archive spanning flight hardware, design reviews, culinary work, mentoring, and pandemic adaptations.',
    href: '/news/hunch/',
    count: hunchSources.length,
    coverage: 'News published 2018-2021 only',
  },
  {
    number: '03',
    title: 'Exploration Potable Water Dispenser',
    eyebrow: 'ISS life support · Leidos',
    description:
      'The path from the legacy station dispenser to xPWD development, installation, microbial checkout, and operational use.',
    href: '/news/potable-water-dispenser/',
    count: potableWaterSources.length,
    coverage: 'Technical baseline through on-orbit follow-up',
  },
];
---

<BaseLayout
  title="News"
  description="Focused public-source archives for aerospace hardware, programs, and the people behind them."
>
  <section class="page-hero news-index-hero">
    <div class="shell page-hero-grid">
      <div>
        <span class="page-hero-index">05 / NEWS ARCHIVE</span>
        <p class="eyebrow">Three focused dossiers</p>
        <h1>Public records, organized around the hardware.</h1>
      </div>
      <div class="page-hero-note">
        <p>
          Each topic separates a short list of orientation pieces from a dated, searchable source
          library. The descriptions stay within publicly released information.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad news-index-section">
    <div class="shell news-topic-grid">
      {topics.map((topic) => (
        <article class="news-topic-card">
          <div class="news-card-topline">
            <span>{topic.number}</span>
            <span>{topic.eyebrow}</span>
          </div>
          <div>
            <p class="news-topic-count">{topic.count} indexed sources</p>
            <h2>{topic.title}</h2>
            <p>{topic.description}</p>
          </div>
          <div class="news-topic-footer">
            <small>{topic.coverage}</small>
            <a href={withBase(topic.href)}>Open archive <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-pad news-method">
    <div class="shell news-method-grid">
      <div>
        <p class="eyebrow">Editorial boundary</p>
        <h2>Useful, not exhaustive by accident.</h2>
      </div>
      <div>
        <p>
          The Flywheel page retains the broad public-source census. HUNCH is intentionally limited
          to 2018-2021. The potable-water archive combines the Leidos program record with NASA's
          technical and on-orbit documentation so development claims can be checked against mission
          evidence.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

