---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import CapabilityEvidenceMap from '../components/CapabilityEvidenceMap.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResumeDocument from '../components/ResumeDocument.astro';
import { withBase } from '../utils/paths';

---

<BaseLayout
  title="Experience"
  description="Zachary Tullier’s aerospace and mechanical engineering experience, resume, and career timeline."
>
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <span class="page-hero-index">02 / EXPERIENCE</span>
        <p class="eyebrow">Experience</p>
        <h1>From open question to verified decision.</h1>
      </div>
      <div class="page-hero-note">
        <p>
          Review the detailed resume, save a clean letter-size PDF, and explore how each
          engineering discipline developed across the career timeline.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad resume-print-section" id="resume">
    <div class="shell">
      <div class="resume-toolbar">
        <p>
          Two-page résumé for US Letter. Print at 100% scale with browser headers and footers off.
        </p>
        <a class="button button--primary" href={withBase('/experience/print/?print=1')} target="_blank" rel="noopener">
          Print / save PDF
        </a>
      </div>

      <ResumeDocument />
    </div>
  </section>

  <section class="principles-section section-pad">
    <div class="shell">
      <SectionHeading
        eyebrow="Career trajectory"
        title="One timeline. Multiple disciplines."
        intro="Education, hands-on hardware, fluid systems, systems integration, verification, and computational physics developed as overlapping tracks—not isolated chapters."
      />
      <CareerTimeline />
    </div>
  </section>

  <section class="section-pad" id="expertise">
    <div class="shell">
      <SectionHeading
        eyebrow="Capabilities in practice"
        title="What I can own—and the evidence behind it."
        intro="Six engineering domains connect breadth of experience to demonstrated application, technical methods, and representative work."
      />
      <CapabilityEvidenceMap />
    </div>
  </section>

</BaseLayout>



