---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout
  title="Experience"
  description="A sanitized experience framework for aerospace and mechanical engineering work."
>
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <span class="page-hero-index">02 / EXPERIENCE</span>
        <p class="eyebrow">Experience</p>
        <h1>From open question to verified decision.</h1>
      </div>
      <div class="page-hero-note">
        <p>
          The role entries below are intentionally generalized placeholders. Replace them with
          approved employer names, dates, scope, and outcomes before publication.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <div class="placeholder-note">
        <strong>Disclosure note</strong>
        <span>
          No employer, customer, vehicle, program, schedule, performance value, or controlled
          technical detail is implied by this starter content.
        </span>
      </div>

      <div class="experience-list">
        <article class="experience-item">
          <div class="experience-period">Recent role · Add dates</div>
          <div class="experience-role">
            <h2>Aerospace / Mechanical Engineering Role</h2>
            <p>Organization name — add approved public name</p>
          </div>
          <ul class="experience-details">
            <li>Describe technical ownership across requirements, analysis, design, or test.</li>
            <li>Replace with a verified outcome; omit customer and program identifiers.</li>
            <li>Name the cross-functional interfaces that are safe to discuss publicly.</li>
          </ul>
        </article>

        <article class="experience-item">
          <div class="experience-period">Prior role · Add dates</div>
          <div class="experience-role">
            <h2>Mechanical Design / Analysis Role</h2>
            <p>Organization name — add approved public name</p>
          </div>
          <ul class="experience-details">
            <li>Summarize the class of hardware or analysis without revealing architecture.</li>
            <li>Use scale or impact only when the number is approved for public release.</li>
            <li>Include one example of how evidence changed an engineering decision.</li>
          </ul>
        </article>

        <article class="experience-item">
          <div class="experience-period">Foundation · Add dates</div>
          <div class="experience-role">
            <h2>Early-Career Engineering Role</h2>
            <p>Organization name — add approved public name</p>
          </div>
          <ul class="experience-details">
            <li>Describe the foundational technical methods developed in this role.</li>
            <li>Highlight responsibility growth with factual, non-sensitive examples.</li>
            <li>Keep tool lists secondary to the engineering problem and result.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="principles-section section-pad">
    <div class="shell">
      <SectionHeading
        eyebrow="Capability arc"
        title="What the experience should demonstrate."
        intro="Use these dimensions to replace generic role text with a compact, evidence-based career story."
      />
      <div class="capability-matrix">
        <article>
          <span>01 / FRAME</span>
          <h3>Problem definition</h3>
          <p>Turn open-ended requests into bounded technical questions and success criteria.</p>
        </article>
        <article>
          <span>02 / BUILD</span>
          <h3>Engineering execution</h3>
          <p>Produce models, designs, test plans, data reductions, and reviewable artifacts.</p>
        </article>
        <article>
          <span>03 / CONNECT</span>
          <h3>Cross-functional judgment</h3>
          <p>Integrate constraints and evidence across design, systems, test, and operations.</p>
        </article>
        <article>
          <span>04 / DECIDE</span>
          <h3>Technical leadership</h3>
          <p>Clarify risk, recommend a path, and preserve a durable decision record.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
