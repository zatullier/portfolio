---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Resume"
  description="The resume is now part of Zachary Tullier’s Experience page."
>
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <span class="page-hero-index">05 / RESUME</span>
        <p class="eyebrow">Resume</p>
        <h1>The resume has moved to Experience.</h1>
      </div>
      <div class="page-hero-note">
        <p>
          Experience now brings the detailed resume and career timeline together in one place.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <div class="placeholder-note">
        <strong>Resume and PDF export</strong>
        <span>
          Open the Experience page to review the resume or use its print control to save a
          letter-size PDF.
        </span>
      </div>
      <div class="hero-actions">
        <a class="button button--primary" href={withBase('/experience/#resume')}>
          View resume on Experience
        </a>
      </div>
    </div>
  </section>
</BaseLayout>


