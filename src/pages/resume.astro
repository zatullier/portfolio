---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title=""
  description="Ayo1"
>
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <span class="page-hero-index">05 / RESUMEAYO</span>
        <p class="eyebrow">ResumeAyo69</p>
        <h1>A concise record, ready for approved details.</h1>
      </div>
      <div class="page-hero-note">
      </div>
        <p>
          Ayo2.
        </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <div class="resume-toolbar">
        <p>
          Ayo3.
        </p>
        <button class="button button--primary" type="button" data-print->
          Print / save PDF
        </button>
      </div>

      <article class="-sheet">
        <header class="-header">
          <div>
            <h1>{site.name}</h1>
            <p>{site.title}</p>
          </div>
          <p class="-contact">
            <span>{site.location}</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <a href={site.github}>{site.github.replace('https://', '')}</a>
          </p>
        </header>

        <section class="-summary">
          <p>
            Systems-focused aerospace and mechanical engineer experienced in leading multimillion-dollar development 
            of safety-critical mechanical and fluid hardware for human-spaceflight programs. 
            Skilled in requirements and interface management, verification planning, configuration control, supplier coordination, 
            and cross-functional execution from design through testing. Graduate research in computational plasma physics adds depth 
            in first-principles analysis, multiphysics modeling, and radiation transport.
          </p>
        </section>
        
        <section class="-section">
          <h2>Education</h2>
          <div class="-entry">
            <div class="-entry-header">
              <div>
                <h3>[Bachelor of Science, Dual Degree - Aerospace Engineering and Mechanical Engineering]</h3>
                <p>[Oklahoma State University]</p>
              </div>
              <span>[2016-2021]</span>
            </div>
            <div class="-entry-header">
              <div>
                <h3>[Masters of Science, Physics]</h3>
                <p>[University of Houston - Clear Lake]</p>
              </div>
              <span>2024-2026</span>
            </div>
            <ul>
              <li>Thesis: Suppression of radiation emissions from relativistic plasma by utilizing magnetic perturbations
                  </li>
              <li>Conducted advanced theoretical and computational modeling of relativistic plasmas, focusing on the mechanisms governing Bremsstrahlung and synchrotron radiation in high-temperature, high-density environments.
                  </li>
              <li>Developed and analyzed multiphysics models describing plasma–magnetic-field interactions, exploring how imposed magnetic perturbations can modify radiation spectra, energy losses, and confinement behavior—concepts applicable to nuclear, fusion, and high-energy reactor systems.
                  </li>
              <li>Applied quantum and classical radiation theory, transport equations, and field-particle interaction models to evaluate how perturbative magnetic geometries influence emissivity, stability, and energy balance.
                  </li>
              <li>Produced research combining plasma physics, electrodynamics, computational modeling, and radiation transport—skills directly translatable to nuclear system analysis, radiation effects evaluation, and multiphysics design integration.
                  </li>
            </ul>
          </div>
        </section>

        <section class="-section">
          <h2>Experience</h2>
          <div>
            <article class="-entry">
              <div class="-entry-header">
                <div>
                  <h3>Project Engineer</h3>
                  <p>Leidos / KBR (NASA Contracts)</p>
                </div>
                <span>NASA Johnson Space Center - Houston, Texas · 2021 - Present</span>
              </div>
              <ul>
                <li>Lead $5M hardware development projects for life support systems supporting Artemis and Blue Origin Moon missions and International Space Station missions.
                    </li>
                <li>Evaluate project impacts on budget, schedule, and resource allocation.
                    </li>
                <li>Developed and maintained system architecture documentation, including system-level requirements, interface definitions,verification plans, test requirements, and mechanical/fluid schematics.
                    </li>
                <li>Interfaced with mechanical, electrical/I&C, software, thermal, structural, quality assurance, procurement, NASA stakeholders, test, and safety teams to ensure system-level requirements were met and maintained through configuration control.
                    </li>
                <li>Translated mission and safety requirements into Design Basis–style documents, engineering specifications, and validation plans.
                    </li>
                <li>Assessed design changes through engineering change packages, coordinating updates to system drawings, requirements, test procedures, and analytical models.
                    </li>
                <li>Developed, integrated and tested safety-critical mechanical and fluid systems for spaceflight hardware, applying strict configuration management, design controls, and standards compliance under NASA/JSC protocols.
                    </li>
                <li>Assessed system-level failure modes or analyzed component-level impacts on mission-critical systems
                    </li>
                <li>Create and interpret engineering drawings in compliance with GD&T, ASME Y14, and NASA/JSC standards, including material, process, and fastener specifications
                    </li>
                <li>Generated technical documentation packages, design reports, verification matrices, safety assessments, and configuration- controlled change packages supporting design certification.
                    </li>
                <li>Provided technical direction to suppliers for component fabrication, verification data packages, inspection requirements, and materials/process compliance.
                    </li>
                <li>Automated data workflows for assemblies comprising 400+ subcomponents.
                    </li>
              </ul>
            </article>


            <article class="-entry">
              <div class="-entry-header">
                <div>
                  <h3>Fluid Systems Engineer</h3>
                  <p>PBK - LEAF Engineers</p>
                </div>
                <span>Houston, Texas · 2021</span>
              </div>
              <ul>
                <li>Designed mechanical piping, pumping, and venting systems across commercial and institutional facilities, applying code-driven requirements (IPC, IMC, NFPA) and engineering criteria for pressure containment, flow performance, materials compatibility, and operational safety.
                    </li>
                <li>Performed pressure-drop, flow balance, and hydraulic performance calculations to validate line sizing, pump requirements, vent routing, and system stability under normal and off-nominal operating conditions.
                    </li>
                <li>Developed standardized analysis tools (Excel/VBA, Python templates) for fluid flow calculations, enabling consistent design packages and reducing engineering cycle time across the team.
                    </li>
                <li>Authored repeatable reporting templates capturing system assumptions, performance criteria, load conditions, and compliance considerations—used by multiple design teams to maintain documentation quality.
                    </li>
                <li>Conducted on-site inspections to compare real-world installation constraints with engineered models, validating space envelopes, routing feasibility, materials condition, tie-in locations, and as-built compliance.
                    </li>
                <li>Coordinated with mechanical, civil, architectural, and controls disciplines to refine routing decisions, address conflicts, and ensure system integration met functional and regulatory requirements.
                    </li>
                <li>Evaluated constructability constraints and provided recommendations to resolve installation conflicts in congested mechanical spaces.
                    </li>
                <li>Supported the creation of equipment schedules, material specification, and cut sheets to ensure selected components met performance, durability, and code-compliance requirements.
                    </li>
              </ul>
            </article>

            <article class="-entry">
              <div class="-entry-header">
                <div>
                  <h3>Design to Flight Engineer and Metal Finishing Technician</h3>
                  <p>NASA HUNCH Program</p>
                </div>
                <span>NASA Johnson Space Center - Houston, Texas · 2019 - 2021</span>
              </div>
              <ul>
                <li>Developed and reviewed mechanical drawings for compliance with NASA/JSC manufacturing and safety standards.
                  </li>
                <li>Produced verification documentation with traceability similar to licensing-style quality packages required for safety-critical hardware.
                  </li>
                <li>Authored assembly and manufacturing procedures for certified flight hardware.
                  </li>
                <li>Conducted cost analyses to guide procurement of components and consumables
                  </li>
                <li>Reverse-engineered student and commercial prototypes for spaceflight compliance evaluation
                  </li>
                <li>Advised student teams to align designs with NASA/JSC flight hardware standards using core engineering principles
                  </li>
                <li>Mentored HUNCH students in collaborative design practices to develop innovative, standards-compliant engineering solutions
                  </li>
              </ul>
            </article>

          </div>
        </section>

        

        <section class="-section">
          <h2>Skills</h2>
          <div class="-skills">
            <div>
              <strong>Engineering Software & CAD</strong>
              <span>Solidworks, Creo, Inventor, AutoCAD, Revit, Onshape, PTC Windchill 
                <li>Process automation, design, and integration
                </li>
                <li>Thermal, fluid, structural, and performance analysis
                </li>
                  </span>
            </div>
            <div>
              <strong>Programming & Automation</strong>
              <span>[Python, MATLAB, Java, VBA, LabVIEW
                <li>Process automation, data acquisition and mechatronic control design, and plasma modeling
                </li>
                  </span>
            </div>
              <div>
              <strong>System Design and Analysis</strong>
              <span>
                    System architecture definition,
                    Requirements development, 
                    Interface controls, 
                    Verification and validation planning, 
                    Failure modes and effects evaluation, 
                    Pressurized system design and test, 
                    Configuration management, 
                    Design review leadership
              </span>
            </div>            
            <div>
              <strong>Laboratory and Manufacturing Tools</strong>
              <span>
                    NASA Assembly Documentation (EDS and COSMIC), 
                    ASME Y14, 
                    Geometric Dimensioning and Tolerancing (GD&T), 
                    Precision torque tools, 
                    Digital Multimeters, 
                    Magnetometer, 
                    Oscilloscope, 
                    Power Supplies, 
                    Micro-Hite, 
                    Micrometers, 
                    Calipers,
                    Optical Comparator,
                    FaroArm,
                    Polymeric Installation,
                    Data Aquisition systems, 
                    Handling Electrostatic Discharge Sensitive Equipment, 
                    Handling Precision Cleaned Hardware, 
                    Laminar Flow Benches,
                    Vibration Table Testing, 
                    Thermal Chamber,
                    Electromagnetic Interference Diagnostic Tools,
                    Acoustic Diagnostic Tools,
                    Compressed Gas Systems, 
                    Pipe Benders, 
                    Fused Deposition Modeling, 
                    Stereolithography, 
                    Manual Mill & Lathe, 
                    Abrasive Finishing, Waterjet, 
                    Thermoforming, 
                    Arc Welding, 
                  </span>
            </div>
          </div>
        </section>
      </article>
    </div>
  </section>

  <script>
    document.querySelector('[data-print-]')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
