---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlightDiagram from '../components/FlightDiagram.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow kicker-line">{site.title}</p>
        <h1>Clarity from first principles to <em>flight-ready</em> decisions.</h1>
        <p class="hero-lede">
          Systems-minded engineering across analysis, hardware, verification, and the technical
          communication that connects them.
        </p>
        <div class="button-row">
          <a class="button button--primary" href={withBase('/projects/')}>
            Explore project work <span aria-hidden="true">↗</span>
          </a>
          <a class="button" href={withBase('/contact/')}>Start a conversation</a>
        </div>
        <p class="hero-availability"><span></span>{site.availability}</p>
      </div>
      <FlightDiagram />
    </div>
  </section>

  <div class="capability-strip" aria-label="Core engineering capabilities">
    <div class="shell">
      <p>Core capabilities</p>
      <span>Analysis</span>
      <span>Mechanical design</span>
      <span>Verification</span>
      <span>Technical writing</span>
    </div>
  </div>

  <section class="selected-work section-pad">
    <div class="shell">
      <div class="section-topline">
        <SectionHeading
          eyebrow="Selected work / sanitized"
          title="Engineering decisions, made inspectable."
          intro="Representative case studies show the reasoning, review artifacts, and decision structure without exposing proprietary program details."
        />
        <a class="text-link" href={withBase('/projects/')}>All projects <span>↗</span></a>
      </div>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </div>
  </section>

  <section class="principles-section section-pad">
    <div class="shell principles-grid">
      <div>
        <p class="eyebrow eyebrow--dark">How I work</p>
        <h2>Rigor that stays useful.</h2>
      </div>
      <div class="principles-list">
        <article class="principle">
          <span>01</span>
          <div>
            <h3>Frame the decision first</h3>
            <p>
              Start with the choice, success criteria, and consequence of being wrong. Analysis
              should answer a decision—not simply generate output.
            </p>
          </div>
        </article>
        <article class="principle">
          <span>02</span>
          <div>
            <h3>Keep assumptions visible</h3>
            <p>
              Traceable inputs and honest uncertainty make work easier to review, update, and
              trust across disciplines.
            </p>
          </div>
        </article>
        <article class="principle">
          <span>03</span>
          <div>
            <h3>Test the highest-leverage unknown</h3>
            <p>
              Focus models, prototypes, and tests on the evidence most likely to change the
              design or close meaningful risk.
            </p>
          </div>
        </article>
        <article class="principle">
          <span>04</span>
          <div>
            <h3>Write for the next engineer</h3>
            <p>
              A durable engineering record explains what was known, what was decided, and why
              that decision was reasonable at the time.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="home-cta section-pad">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h2>Have a hard engineering question?</h2>
      <p>
        I’m interested in teams that value careful reasoning, collaborative hardware development,
        and clear technical judgment.
      </p>
      <div class="button-row">
        <a class="button button--primary" href={withBase('/contact/')}>Get in touch</a>
        <a class="button" href={withBase('/resume/')}>View résumé</a>
      </div>
    </div>
  </section>
</BaseLayout>
