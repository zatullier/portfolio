---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlightDiagram from '../components/FlightDiagram.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow kicker-line">{site.title}</p>
        <h1>Clarity from <em>assumptions</em> to <em>delivery</em></h1>
        <p class="hero-lede">
          Systems-minded engineering across analysis, hardware, verification, and the technical
          communication that connects them.
        </p>
        <div class="button-row">
        <a class="button button--primary" href={withBase('/about/')}>Learn more about ME</a>
        <a class="button" href={withBase('/resume/')}>Explore my professional experience and education</a>
        </div>
      </div>
    </div>
  </section>

  <section class="selected-work section-pad">
    <div class="shell">
      <div class="section-topline">
        <SectionHeading
          eyebrow="Selected work"
          title="Inspectable Models, Engineering decisions, and Useful Tools"
        />

      </div>
        <div class="button-row">
          <a class="button button--primary" href={withBase('/projects/')}>
            Explore all projects <span aria-hidden="true">↗</span>
          </a>
        </div>
      <div class="project-grid">
        {projects
          .filter((project) => ['01', '02', '04'].includes(project.number))
          .map((project) => <ProjectCard project={project} compact />)
        }
      </div>
    </div>
  </section>

  <section class="selected-work section-pad">
    <div class="shell">
      <div class="section-topline">
        <SectionHeading
          eyebrow="Selected writing"
          title="Translating Complex Technical Work into Clear, Accessible Insight"
        />

      </div>
        <div class="button-row">
          <a class="button button--primary" href={withBase('/writing/')}>
            Explore all papers <span aria-hidden="true">↗</span>
          </a>
        </div>
      <div class="project-grid">
        {projects
          .filter((project) => ['01'].includes(project.number))
          .map((project) => <ProjectCard project={project} compact />)
        }
      </div>
    </div>
  </section>

  <section class="principles-section section-pad">
    <div class="shell principles-grid">
      <div>
        <p class="eyebrow eyebrow--dark">Public Record</p>
        <h2>Flight-Critical Engineering Contributions in the Public Record</h2>
      </div>
      <div class="principles-list">
        <article class="principle">
          <span>01</span>
          <div>
            <h3>Orion Flywheel Exercise Device</h3>
            <p>
              This collection traces the engineering, testing, and flight history of Orion’s compact exercise system. I have served as the project’s technical subject matter expert since qualification-unit development, providing technical leadership across assembly, testing, verification, integration, and the AR-II flight evaluation.
            </p>
            <div class="button-row">
            <a class="button button--primary" href={withBase('/news/flywheel/')}>Read News articles</a>
            </div>
          </div>
        </article>
        <article class="principle">
          <span>02</span>
          <div>
            <h3>NASA HUNCH</h3>
            <p>
              This four-year archive highlights my work with High school students United with NASA to Create Hardware (HUNCH), transforming student concepts into flight-ready documentation and hardware for the International Space Station. It also covers flight-locker assembly and inspection, design reviews, and mentoring at Meridian Technology Center.
            </p>
            <div class="button-row">
            <a class="button button--primary" href={withBase('/news/hunch/')}>Read News articles</a>
            </div>
          </div>
        </article>
        <article class="principle">
          <span>03</span>
          <div>
            <h3>xPWD</h3>
            <p>
              This collection traces the legacy ISS dispenser through Explorationa Potable Water Dispenser (xPWD) development, installation, microbial checkout, and operational use. I served as the development-phase subject matter expert, building the development unit and conducting preliminary performance evaluations.
            </p>
            <div class="button-row">
            <a class="button button--primary" href={withBase('/news/potable-water-dispenser/')}>Read News articles</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="home-cta section-pad">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h2>Let's Talk</h2>
      <p>
        I’m seeking a remote engineering role in nuclear fusion where I can apply rigorous analysis, collaborative hardware development, and sound technical judgment to complex energy challenges.
      </p>
      <div class="button-row">
        <a class="button button--primary" href={withBase('/contact/')}>Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
