---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WritingCard from '../components/WritingCard.astro';
import { writing } from '../data/writing';
---

<BaseLayout
  title="Technical Writing"
  description="Public engineering notes on technical decisions, verification, and review practice."
>
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div>
        <span class="page-hero-index">04 / TECHNICAL WRITING</span>
        <p>
          Clear, concise writing is essential for communicating technical results. This page features selected research and public-facing work that demonstrates my ability to synthesize complex ideas, organize findings, and present them in an accessible format.        
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected work"
        intro="Original research and articles that show my assumptions, rationale, boundaries, and evidence behind my work."
      />
      <div class="writing-list">
        {writing.map((piece, index) => <WritingCard piece={piece} index={index} />)}
      </div>
    </div>
  </section>

</BaseLayout>

