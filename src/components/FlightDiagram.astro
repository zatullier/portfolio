<div class="flight-diagram" aria-label="Abstract orbital flight-path and engineering coordinate diagram" role="img">
  <svg viewBox="0 0 620 620" aria-hidden="true">
    <defs>
      <linearGradient id="flightGlow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#b8ff72" />
        <stop offset="1" stop-color="#5bbcff" />
      </linearGradient>
      <radialGradient id="bodyShade" cx="32%" cy="28%" r="70%">
        <stop offset="0" stop-color="#25424d" />
        <stop offset="1" stop-color="#0b171d" />
      </radialGradient>
      <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
    </defs>

    <g class="diagram-grid" fill="none" stroke="currentColor">
      <circle cx="310" cy="310" r="252" />
      <circle cx="310" cy="310" r="188" />
      <path d="M58 310h504M310 58v504" />
      <path d="m132 132 356 356M488 132 132 488" />
    </g>

    <g class="diagram-orbits" fill="none">
      <ellipse cx="310" cy="310" rx="252" ry="108" transform="rotate(-24 310 310)" />
      <ellipse cx="310" cy="310" rx="150" ry="252" transform="rotate(38 310 310)" />
    </g>

    <circle class="diagram-glow" cx="310" cy="310" r="104" fill="#5bbcff" filter="url(#softGlow)" />
    <circle cx="310" cy="310" r="91" fill="url(#bodyShade)" stroke="#47626b" stroke-width="1.5" />
    <path class="body-contour" d="M237 333c44-17 52-58 76-71 27-15 61-1 74 19M246 357c41 13 83 14 129-7" />

    <path class="flight-path" d="M88 418C191 532 452 485 534 259" />
    <path class="flight-path flight-path--ghost" d="M89 418C191 532 452 485 534 259" />

    <g class="vehicle" transform="translate(498 295) rotate(-42)">
      <path d="M0 0 35 10 0 20l7-10Z" fill="url(#flightGlow)" />
      <path d="M4 7-14 10 4 13" fill="none" stroke="#b8ff72" stroke-width="2" />
    </g>

    <g class="diagram-node">
      <circle cx="92" cy="418" r="5" />
      <circle cx="92" cy="418" r="13" fill="none" />
    </g>
    <g class="diagram-node">
      <circle cx="534" cy="259" r="5" />
      <circle cx="534" cy="259" r="13" fill="none" />
    </g>

    <g class="diagram-labels">
      <text x="70" y="391">T₀</text>
      <text x="512" y="237">T₁</text>
      <text x="327" y="82">+Y</text>
      <text x="543" y="301">+X</text>
      <text x="35" y="575">TRAJECTORY / SYSTEM / MARGIN</text>
    </g>
  </svg>

  <div class="diagram-readout diagram-readout--top">
    <span>REFERENCE</span>
    <strong>BODY FRAME</strong>
  </div>
  <div class="diagram-readout diagram-readout--bottom">
    <span>STATUS</span>
    <strong>TRACEABLE</strong>
  </div>
</div>
