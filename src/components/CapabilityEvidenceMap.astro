---
import { engineeringCapabilities, technicalToolkit } from '../data/capabilities';
---

<div class="capability-evidence">
  <div class="capability-evidence__intro">
    <p class="eyebrow">How to read this section</p>
    <p>
      Each domain connects a scope of ownership to the environments, evidence, and methods behind
      it. Tools are listed separately because software supports the work—it does not define the
      capability.
    </p>
  </div>

  <div class="capability-evidence__grid">
    {
      engineeringCapabilities.map((capability) => (
        <article class="capability-evidence__item">
          <header>
            <span>{capability.number}</span>
            <h3>{capability.title}</h3>
          </header>

          <div class="capability-evidence__ownership">
            <p class="capability-evidence__label">Can own</p>
            <p>{capability.ownership}</p>
          </div>

          <div class="capability-evidence__details">
            <div>
              <p class="capability-evidence__label">Applied in</p>
              <ul>
                {capability.contexts.map((context) => <li>{context}</li>)}
              </ul>
            </div>
            <div>
              <p class="capability-evidence__label">Methods & tools</p>
              <ul>
                {capability.methods.map((method) => <li>{method}</li>)}
              </ul>
            </div>
          </div>

          <div class="capability-evidence__proof">
            <p class="capability-evidence__label">Representative evidence</p>
            <p>{capability.evidence}</p>
            {
              capability.proofs && (
                <div class="capability-evidence__links">
                  {capability.proofs.map((proof) => (
                    <a href={proof.href}>{proof.label} <span aria-hidden="true">↗</span></a>
                  ))}
                </div>
              )
            }
          </div>
        </article>
      ))
    }
  </div>

  <section class="technical-toolkit" aria-labelledby="technical-toolkit-title">
    <div class="technical-toolkit__heading">
      <div>
        <p class="eyebrow">Technical toolkit</p>
        <h3 id="technical-toolkit-title">Methods used to deliver the work.</h3>
      </div>
      <p>
        A supporting inventory of standards, processes, analysis methods, and software—not a
        self-rated proficiency chart.
      </p>
    </div>

    <div class="technical-toolkit__groups">
      {
        technicalToolkit.map((group) => (
          <div>
            <h4>{group.title}</h4>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</div>

<style>
  .capability-evidence {
    border-top: 1px solid var(--line-strong);
  }

  .capability-evidence__intro {
    display: grid;
    grid-template-columns: minmax(11rem, 0.8fr) minmax(0, 2.2fr);
    gap: 1.5rem;
    padding: 1.5rem 0 2.25rem;
  }

  .capability-evidence__intro p {
    margin: 0;
  }

  .capability-evidence__intro > p:last-child {
    max-width: 54rem;
    color: var(--ink-soft);
  }

  .capability-evidence__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .capability-evidence__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1.35rem;
    padding: clamp(1.35rem, 3vw, 2.1rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
  }

  .capability-evidence__item header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: baseline;
  }

  .capability-evidence__item header > span {
    color: var(--lime);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .capability-evidence__item h3 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.15;
  }

  .capability-evidence__label {
    margin: 0 0 0.35rem;
    color: var(--ink-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .capability-evidence__ownership > p:last-child,
  .capability-evidence__proof > p:nth-child(2) {
    margin: 0;
  }

  .capability-evidence__ownership > p:last-child {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.6;
  }

  .capability-evidence__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .capability-evidence ul,
  .technical-toolkit ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability-evidence li,
  .technical-toolkit li {
    position: relative;
    padding-left: 0.85rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .capability-evidence li::before,
  .technical-toolkit li::before {
    position: absolute;
    top: 0.68em;
    left: 0;
    width: 0.24rem;
    height: 0.24rem;
    border-radius: 50%;
    background: var(--blue);
    content: '';
  }

  .capability-evidence li + li,
  .technical-toolkit li + li {
    margin-top: 0.25rem;
  }

  .capability-evidence__proof {
    margin-top: auto;
    padding: 1rem 1.05rem;
    border-left: 2px solid var(--lime);
    background: rgba(184, 255, 114, 0.035);
  }

  .capability-evidence__proof > p:nth-child(2) {
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .capability-evidence__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin-top: 0.8rem;
  }

  .capability-evidence__links a {
    color: var(--lime);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  .technical-toolkit {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .technical-toolkit__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 2rem;
    align-items: end;
  }

  .technical-toolkit__heading .eyebrow {
    margin-bottom: 0.55rem;
  }

  .technical-toolkit__heading h3 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
  }

  .technical-toolkit__heading > p {
    margin: 0;
    color: var(--ink-soft);
  }

  .technical-toolkit__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .technical-toolkit__groups > div {
    padding: 1.35rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .technical-toolkit h4 {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .capability-evidence__intro,
    .technical-toolkit__heading {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .capability-evidence__grid {
      grid-template-columns: 1fr;
    }

    .technical-toolkit__groups {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .capability-evidence__details {
      grid-template-columns: 1fr;
    }

    .technical-toolkit__heading {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

