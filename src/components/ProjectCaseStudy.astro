---
import type { Project } from '../data/projects';

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<article class="case-study">
  <section class="case-hero section-pad">
    <div class="shell case-hero-grid">
      <div>
        <p class="eyebrow">Case study / {project.number}</p>
        <h3>{project.title}</h3>
        <p class="hero-lede">{project.summary}</p>
      </div>
      <aside class="case-meta">.
<!--
        <p class="case-status"><span></span>{project.status}</p>
-->
        <dl>
          <div>
            <dt>Status</dt>
            <dd>{project.status}</dd>
          </div>  
          <div>
            <dt>Disciplines</dt>
            <dd>{project.disciplines.join(' · ')}</dd>
          </div>
          <div>
            <dt>Tools Used</dt>
            <dd>No proprietary values or identifiers</dd>
<!--            <dd>{project.tools.join(' · ')}</dd>  -->
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="paper-section section-pad">
    <div class="shell content-grid">
      <div class="content-label">
        <span>Section 1</span>
        <p>Challenge</p>
      </div>
      <div class="prose-large">
        <p>{project.challenge}</p>
        <h3>Constraints</h3>
        <ul class="constraint-list">
          {project.constraints.map((constraint) => <li>{constraint}</li>)}
        </ul>
      </div>
    </div>
  </section>

<!-- 
  <section class="section-pad">
    <div class="shell content-grid">
      <div class="content-label">
        <span>Section 2</span>
        <p>Assumptions</p>
      </div>
      <div>
        <h5>{project.assumptionSummary}</h5>
        <div class="process-grid">
          {
            project.assumption.map((step, index) => (
              <article class="process-step">
                <span>Assumption {index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>
-->

  <section class="section-pad">
    <div class="shell content-grid">
      <div class="content-label">
        <span>Section 3</span>
        <p>Approach</p>
      </div>
      <div>
        <h5>ill pull data from previous whatever and plug it into generated blah blah verifing the repeatability and reliability then implement it into blah.</h5>
<!--         <h5>{project.approachSummary}</h5>  -->
        <div class="process-grid">
          {
            project.approach.map((step, index) => (
              <article class="process-step">
                <span>0{index + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="accent-section section-pad">
    <div class="shell content-grid">
      <div class="content-label content-label--dark">
        <span>Section 4</span>
        <p>Outputs</p>
      </div>
      <div>
<!--         <h5>{project.approachSummary}</h5>  -->
        <ol class="artifact-list">
          {project.artifacts.map((artifact, index) => <li><span>Artifact {index + 1}</span>{artifact}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="paper-section section-pad">
    <div class="shell outcome-grid">
      <div>
        <p class="eyebrow eyebrow--dark">Outcome</p>
        <p>{project.outcome}</p>
      </div>
      <blockquote>
        <p>{project.reflection}</p>
        <footer>Engineering reflection</footer>
      </blockquote>
    </div>
  </section>
</article>
