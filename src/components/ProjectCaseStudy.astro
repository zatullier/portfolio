---
import type { Project } from '../data/projects';

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<article class="case-study">
  <section class="case-hero section-pad">
    <div class="shell case-hero-grid">
      <div>
        <p class="eyebrow">Case study / {project.number}</p>
        <h1>{project.title}</h1>
        <p class="hero-lede">{project.summary}</p>
      </div>
      <aside class="case-meta">
        <dl>
          <div>
            <dt>Status</dt>
            <dd>{project.status}</dd>
          </div>
          <div>
            <dt>Disciplines</dt>
            <dd>{project.disciplines.join(' · ')}</dd>
          </div>
          {project.tools && (
            <div>
              <dt>Tools and formats</dt>
              <dd>{project.tools.join(' · ')}</dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </section>

  {project.resources && (
    <section class="case-resource-section section-pad" aria-label={project.resourceLabel ?? 'Project resources'}>
      <div class="shell content-grid">
        <div class="content-label">
          <span>Resources</span>
          <p>{project.resourceLabel ?? 'Project files'}</p>
        </div>
        <div class="case-resource-list">
          {project.resources.map((resource) => (
            <a href={resource.href} target="_blank" rel="noreferrer">
              <span>
                <strong>{resource.label}</strong>
                <small>{resource.description}</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="paper-section section-pad">
    <div class="shell content-grid">
      <div class="content-label">
        <span>Section 1</span>
        <p>Challenge</p>
      </div>
      <div class="prose-large">
        <p>{project.challenge}</p>
        <h3>Constraints</h3>
        <ul class="constraint-list">
          {project.constraints.map((constraint) => <li>{constraint}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="shell content-grid">
      <div class="content-label">
        <span>Section 2</span>
        <p>Approach</p>
      </div>
      <div>
        {project.approachSummary && <p class="section-intro">{project.approachSummary}</p>}
        <div class="process-grid">
          {project.approach.map((step, index) => (
            <article class="process-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="accent-section section-pad">
    <div class="shell content-grid">
      <div class="content-label content-label--dark">
        <span>Section 3</span>
        <p>Outputs</p>
      </div>
      <ol class="artifact-list">
        {project.artifacts.map((artifact, index) => <li><span>Artifact {index + 1}</span>{artifact}</li>)}
      </ol>
    </div>
  </section>

  <section class="paper-section section-pad">
    <div class="shell outcome-grid">
      <div>
        <p class="eyebrow eyebrow--dark">Outcome</p>
        <p>{project.outcome}</p>
      </div>
      <blockquote>
        <p>{project.reflection}</p>
        <footer>Engineering reflection</footer>
      </blockquote>
    </div>
  </section>
</article>

