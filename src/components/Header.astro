---
import { navigation, site } from '../data/site';
import { isActivePath, withBase } from '../utils/paths';

type Props = {
  currentPath: string;
};

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name} home`}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M4 20.5 12.5 16l5.2-9 1.4 7.1L28 17l-8.9 1.2-4.6 7.2-1.8-6.1Z" fill="currentColor" />
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActivePath(currentPath, item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {
          navigation.map((item) => (
            <a
              href={withBase(item.href)}
              aria-current={isActivePath(currentPath, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
