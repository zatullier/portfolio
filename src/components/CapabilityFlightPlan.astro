---
import { expertiseScale, expertiseSkills } from '../data/expertise';

const initialSkill = expertiseSkills[0];
const stars = Array.from({ length: 54 }, (_, index) => ({
  x: (index * 37 + 11) % 97,
  y: (index * 53 + 7) % 91,
  size: 1 + (index % 3),
  opacity: 0.22 + (index % 5) * 0.13,
}));
---

<div class="capability-flight" data-capability-flight data-progress="1">
  <div class="capability-flight__visual">
    <div class="capability-flight__scene" data-flight-scene>
      <div class="capability-flight__stars" aria-hidden="true">
        {
          stars.map((star) => (
            <i
              style={`--star-x:${star.x}%;--star-y:${star.y}%;--star-size:${star.size}px;--star-opacity:${star.opacity}`}
            />
          ))
        }
      </div>

      <div class="capability-flight__telemetry" aria-hidden="true">
        <span>CAPABILITY NAV / 08</span>
        <span data-flight-coordinate>RANGE 100%</span>
      </div>

      <div class="capability-flight__scene-label capability-flight__scene-label--launch">
        <span>01</span>
        <strong>Launch</strong>
      </div>
      <div class="capability-flight__scene-label capability-flight__scene-label--orbit">
        <span>04</span>
        <strong>Applied orbit</strong>
      </div>
      <div class="capability-flight__scene-label capability-flight__scene-label--command">
        <span>08</span>
        <strong>Mission command</strong>
      </div>

      <svg
        class="capability-flight__map"
        data-flight-map
        viewBox="0 0 760 520"
        role="img"
        aria-label={`${initialSkill.title}: mission range ${initialSkill.level} of 8, ${expertiseScale[initialSkill.level]}`}
      >
        <defs>
          <radialGradient id="earth-surface" cx="34%" cy="26%" r="75%">
            <stop offset="0" stop-color="var(--ink)" />
            <stop offset="0.12" stop-color="var(--blue)" />
            <stop offset="0.62" stop-color="var(--night-soft)" />
            <stop offset="1" stop-color="var(--night)" />
          </radialGradient>
          <radialGradient id="destination-surface" cx="34%" cy="25%" r="76%">
            <stop offset="0" stop-color="var(--ink)" />
            <stop offset="0.16" stop-color="var(--orange)" />
            <stop offset="0.72" stop-color="var(--night-soft)" />
            <stop offset="1" stop-color="var(--night)" />
          </radialGradient>
          <filter id="planet-glow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="12" />
          </filter>
          <filter id="vehicle-glow" x="-120%" y="-120%" width="340%" height="340%">
            <feGaussianBlur stdDeviation="5" />
          </filter>
        </defs>

        <g class="capability-flight__planet capability-flight__planet--home" aria-hidden="true">
          <circle class="capability-flight__planet-halo" cx="74" cy="454" r="126" />
          <circle cx="74" cy="454" r="96" fill="url(#earth-surface)" />
          <path d="M5 422c42-26 71-9 100-35 22-20 46-14 65-5" />
          <path d="M13 470c31-12 52 8 83-4 28-11 47 1 66 17" />
        </g>

        <g class="capability-flight__moon" aria-hidden="true">
          <circle class="capability-flight__moon-orbit" cx="392" cy="274" r="55" />
          <circle cx="392" cy="274" r="25" />
          <circle cx="384" cy="266" r="4" />
          <circle cx="402" cy="281" r="6" />
        </g>

        <g class="capability-flight__planet capability-flight__planet--destination" aria-hidden="true">
          <circle class="capability-flight__destination-glow" cx="701" cy="91" r="61" />
          <circle cx="701" cy="91" r="43" fill="url(#destination-surface)" />
          <ellipse cx="701" cy="91" rx="69" ry="15" />
        </g>

        <path
          class="capability-flight__route-base"
          data-flight-path
          pathLength="100"
          d="M111 417 C190 294 287 409 376 290 S568 92 685 108"
        />
        <path
          class="capability-flight__route-progress"
          data-flight-progress
          pathLength="100"
          d="M111 417 C190 294 287 409 376 290 S568 92 685 108"
        />

        {
          Array.from({ length: 8 }, (_, index) => (
            <circle
              class:list={['capability-flight__waypoint', index < initialSkill.level && 'is-reached']}
              data-flight-waypoint
              data-waypoint-index={index + 1}
              cx="0"
              cy="0"
              r="5"
              aria-hidden="true"
            />
          ))
        }

        <g class="capability-flight__vehicle-glow" data-flight-vehicle-glow aria-hidden="true">
          <circle r="14" />
        </g>
        <g class="capability-flight__vehicle" data-flight-vehicle aria-hidden="true">
          <path class="capability-flight__vehicle-body" d="M12 0-9 7-4 0-9-7Z" />
          <path class="capability-flight__vehicle-wing" d="m-2-4-9-8 3 12-3 12 9-8Z" />
          <path class="capability-flight__vehicle-signal" d="M-13 0h-13" />
        </g>
      </svg>
    </div>

    <div class="capability-flight__readout" aria-live="polite">
      <div>
        <span data-flight-category>{initialSkill.category}</span>
        <h3 data-flight-title>{initialSkill.title}</h3>
      </div>
      <div class="capability-flight__range">
        <strong><span data-flight-level>{initialSkill.level}</span> / 8</strong>
        <span data-flight-label>{expertiseScale[initialSkill.level]}</span>
      </div>
      <p data-flight-evidence>{initialSkill.evidence}</p>
    </div>
  </div>

  <div class="capability-flight__controls">
    <div class="capability-flight__controls-heading">
      <p class="eyebrow">Select a flight profile</p>
      <p>Mission range represents demonstrated independence, complexity, and technical ownership.</p>
    </div>

    <div class="capability-flight__skills">
      {
        expertiseSkills.map((skill, index) => (
          <button
            class:list={['capability-flight__skill', index === 0 && 'is-active']}
            type="button"
            data-flight-choice
            data-title={skill.title}
            data-category={skill.category}
            data-evidence={skill.evidence}
            data-level={skill.level}
            data-level-label={expertiseScale[skill.level]}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span class="capability-flight__skill-copy">
              <strong>{skill.title}</strong>
              <small>{skill.category}</small>
            </span>
            <span
              class="capability-flight__mini-range"
              aria-label={`Mission range ${skill.level} of 8, ${expertiseScale[skill.level]}`}
            >
              {
                Array.from({ length: 8 }, (_, stage) => (
                  <i class:list={[stage < skill.level && 'is-reached']} aria-hidden="true" />
                ))
              }
            </span>
          </button>
        ))
      }
    </div>

    <div class="capability-flight__scale" aria-label="Mission range scale">
      <span><strong>1–2</strong> Launch / foundation</span>
      <span><strong>3–4</strong> Applied orbit</span>
      <span><strong>5–6</strong> Advanced mission</span>
      <span><strong>7–8</strong> Specialist / command</span>
    </div>
  </div>
</div>

<script>
  const flightPlans = document.querySelectorAll<HTMLElement>('[data-capability-flight]');

  flightPlans.forEach((root) => {
    const choices = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-flight-choice]'));
    const waypoints = Array.from(root.querySelectorAll<SVGCircleElement>('[data-flight-waypoint]'));
    const scene = root.querySelector<HTMLElement>('[data-flight-scene]');
    const map = root.querySelector<SVGElement>('[data-flight-map]');
    const path = root.querySelector<SVGPathElement>('[data-flight-path]');
    const progressPath = root.querySelector<SVGPathElement>('[data-flight-progress]');
    const vehicle = root.querySelector<SVGGElement>('[data-flight-vehicle]');
    const vehicleGlow = root.querySelector<SVGGElement>('[data-flight-vehicle-glow]');
    const title = root.querySelector<HTMLElement>('[data-flight-title]');
    const category = root.querySelector<HTMLElement>('[data-flight-category]');
    const evidence = root.querySelector<HTMLElement>('[data-flight-evidence]');
    const levelText = root.querySelector<HTMLElement>('[data-flight-level]');
    const levelLabel = root.querySelector<HTMLElement>('[data-flight-label]');
    const coordinate = root.querySelector<HTMLElement>('[data-flight-coordinate]');
    let animationFrame = 0;

    if (!path) return;
    const pathLength = path.getTotalLength();

    const pointAt = (progress: number) => path.getPointAtLength(pathLength * progress);

    const placeVehicle = (progress: number) => {
      const point = pointAt(progress);
      const next = pointAt(Math.min(1, progress + 0.006));
      const angle = Math.atan2(next.y - point.y, next.x - point.x) * (180 / Math.PI);
      const transform = `translate(${point.x} ${point.y}) rotate(${angle})`;
      vehicle?.setAttribute('transform', transform);
      vehicleGlow?.setAttribute('transform', `translate(${point.x} ${point.y})`);
    };

    waypoints.forEach((waypoint, index) => {
      const point = pointAt((index + 1) / 8);
      waypoint.setAttribute('cx', String(point.x));
      waypoint.setAttribute('cy', String(point.y));
    });

    placeVehicle(1);

    const animateVehicle = (targetProgress: number) => {
      const startProgress = Number(root.dataset.progress ?? 1);
      const start = performance.now();
      const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 620;
      cancelAnimationFrame(animationFrame);

      const step = (now: number) => {
        const elapsed = duration === 0 ? 1 : Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - elapsed, 3);
        placeVehicle(startProgress + (targetProgress - startProgress) * eased);
        if (elapsed < 1) {
          animationFrame = requestAnimationFrame(step);
        } else {
          root.dataset.progress = String(targetProgress);
        }
      };

      animationFrame = requestAnimationFrame(step);
    };

    const selectSkill = (choice: HTMLButtonElement) => {
      const level = Number(choice.dataset.level);
      const targetProgress = level / 8;
      const skillTitle = choice.dataset.title ?? '';
      const skillCategory = choice.dataset.category ?? '';
      const skillEvidence = choice.dataset.evidence ?? '';
      const skillLabel = choice.dataset.levelLabel ?? '';

      choices.forEach((button) => {
        const active = button === choice;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      waypoints.forEach((waypoint) => {
        const index = Number(waypoint.dataset.waypointIndex);
        waypoint.classList.toggle('is-reached', index <= level);
      });

      progressPath?.style.setProperty('stroke-dashoffset', String(100 - targetProgress * 100));
      animateVehicle(targetProgress);

      if (title) title.textContent = skillTitle;
      if (category) category.textContent = skillCategory;
      if (evidence) evidence.textContent = skillEvidence;
      if (levelText) levelText.textContent = String(level);
      if (levelLabel) levelLabel.textContent = skillLabel;
      if (coordinate) coordinate.textContent = `RANGE ${Math.round(targetProgress * 100)}%`;
      map?.setAttribute(
        'aria-label',
        `${skillTitle}: mission range ${level} of 8, ${skillLabel}`
      );
    };

    choices.forEach((choice) => {
      choice.addEventListener('click', () => selectSkill(choice));
    });

    if (scene && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      scene.addEventListener('pointermove', (event) => {
        const bounds = scene.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        scene.style.setProperty('--scene-rx', `${-y * 3.5}deg`);
        scene.style.setProperty('--scene-ry', `${x * 5}deg`);
        scene.style.setProperty('--stars-x', `${x * -7}px`);
        scene.style.setProperty('--stars-y', `${y * -7}px`);
      });

      scene.addEventListener('pointerleave', () => {
        scene.style.setProperty('--scene-rx', '0deg');
        scene.style.setProperty('--scene-ry', '0deg');
        scene.style.setProperty('--stars-x', '0px');
        scene.style.setProperty('--stars-y', '0px');
      });
    }
  });
</script>

<style>
  .capability-flight {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .capability-flight__visual {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--night-raised);
    box-shadow: inset 0 0 5rem rgba(0, 0, 0, 0.25);
  }

  .capability-flight__scene {
    --scene-rx: 0deg;
    --scene-ry: 0deg;
    --stars-x: 0px;
    --stars-y: 0px;
    position: relative;
    isolation: isolate;
    min-height: 30rem;
    overflow: hidden;
    perspective: 900px;
    background:
      radial-gradient(circle at 78% 17%, rgba(255, 176, 91, 0.1), transparent 16rem),
      radial-gradient(circle at 21% 75%, rgba(91, 188, 255, 0.14), transparent 19rem),
      linear-gradient(145deg, #071116, var(--night-raised));
    touch-action: pan-y;
  }

  .capability-flight__scene::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      linear-gradient(rgba(91, 188, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(91, 188, 255, 0.035) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    content: '';
    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    transform: perspective(500px) rotateX(56deg) scale(1.35) translateY(19%);
    transform-origin: center bottom;
  }

  .capability-flight__stars {
    position: absolute;
    z-index: 0;
    inset: -0.75rem;
    transform: translate(var(--stars-x), var(--stars-y));
    transition: transform 180ms ease-out;
  }

  .capability-flight__stars i {
    position: absolute;
    top: var(--star-y);
    left: var(--star-x);
    width: var(--star-size);
    height: var(--star-size);
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0.45rem rgba(91, 188, 255, 0.55);
    opacity: var(--star-opacity);
  }

  .capability-flight__telemetry {
    position: absolute;
    z-index: 3;
    top: 1rem;
    right: 1rem;
    left: 1rem;
    display: flex;
    justify-content: space-between;
    color: var(--ink-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .capability-flight__map {
    position: absolute;
    z-index: 2;
    inset: 2.25rem 0 0;
    width: 100%;
    height: calc(100% - 2.25rem);
    overflow: visible;
    transform: rotateX(var(--scene-rx)) rotateY(var(--scene-ry));
    transform-origin: center;
    transform-style: preserve-3d;
    transition: transform 180ms ease-out;
  }

  .capability-flight__planet-halo,
  .capability-flight__destination-glow {
    fill: rgba(91, 188, 255, 0.12);
    filter: url(#planet-glow);
  }

  .capability-flight__planet--home path {
    fill: none;
    stroke: rgba(184, 255, 114, 0.28);
    stroke-width: 3;
  }

  .capability-flight__planet--destination ellipse {
    fill: none;
    stroke: rgba(255, 176, 91, 0.52);
    stroke-width: 2;
    transform: rotate(-12deg);
    transform-origin: 701px 91px;
  }

  .capability-flight__destination-glow {
    fill: rgba(255, 176, 91, 0.16);
  }

  .capability-flight__moon-orbit {
    fill: none !important;
    stroke: rgba(226, 237, 233, 0.1);
    stroke-width: 1;
    stroke-dasharray: 3 7;
  }

  .capability-flight__moon circle:not(.capability-flight__moon-orbit) {
    fill: var(--ink-soft);
  }

  .capability-flight__moon circle:nth-of-type(n + 3) {
    fill: var(--night-soft);
    opacity: 0.55;
  }

  .capability-flight__route-base,
  .capability-flight__route-progress {
    fill: none;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .capability-flight__route-base {
    stroke: rgba(226, 237, 233, 0.17);
    stroke-dasharray: 4 8;
  }

  .capability-flight__route-progress {
    stroke: var(--lime);
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 5px rgba(184, 255, 114, 0.55));
    transition: stroke-dashoffset 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .capability-flight__waypoint {
    fill: var(--night);
    stroke: var(--line-strong);
    stroke-width: 2;
    transition: fill 220ms ease, stroke 220ms ease;
  }

  .capability-flight__waypoint.is-reached {
    fill: var(--lime);
    stroke: var(--lime);
    filter: drop-shadow(0 0 4px rgba(184, 255, 114, 0.75));
  }

  .capability-flight__vehicle-glow circle {
    fill: rgba(184, 255, 114, 0.45);
    filter: url(#vehicle-glow);
  }

  .capability-flight__vehicle-body {
    fill: var(--ink);
    stroke: var(--lime);
    stroke-width: 1.5;
  }

  .capability-flight__vehicle-wing {
    fill: var(--blue);
    stroke: var(--ink);
    stroke-width: 1;
  }

  .capability-flight__vehicle-signal {
    fill: none;
    stroke: var(--lime);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .capability-flight__scene-label {
    position: absolute;
    z-index: 4;
    display: grid;
    color: var(--ink-soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    pointer-events: none;
    text-transform: uppercase;
  }

  .capability-flight__scene-label span {
    color: var(--lime);
  }

  .capability-flight__scene-label--launch {
    bottom: 5.8rem;
    left: 1.2rem;
  }

  .capability-flight__scene-label--orbit {
    top: 48%;
    left: 48%;
  }

  .capability-flight__scene-label--command {
    top: 4rem;
    right: 1.2rem;
    text-align: right;
  }

  .capability-flight__readout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem 1.5rem;
    align-items: end;
    padding: 1.4rem clamp(1.25rem, 3vw, 2rem) 1.6rem;
    border-top: 1px solid var(--line);
    background: rgba(8, 18, 22, 0.76);
  }

  .capability-flight__readout h3 {
    margin: 0.25rem 0 0;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
  }

  .capability-flight__readout > div:first-child > span,
  .capability-flight__range > span {
    color: var(--lime);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .capability-flight__range {
    display: grid;
    justify-items: end;
  }

  .capability-flight__range strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1rem;
  }

  .capability-flight__readout > p {
    grid-column: 1 / -1;
    max-width: 58ch;
    margin: 0.35rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .capability-flight__controls-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.25rem;
  }

  .capability-flight__controls-heading .eyebrow {
    margin: 0;
    white-space: nowrap;
  }

  .capability-flight__controls-heading > p:last-child {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  .capability-flight__skills {
    border-top: 1px solid var(--line);
  }

  .capability-flight__skill {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 0.85rem 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: background-color 160ms ease, padding-left 160ms ease;
  }

  .capability-flight__skill:hover,
  .capability-flight__skill.is-active {
    padding-left: 1rem;
    background: rgba(91, 188, 255, 0.08);
  }

  .capability-flight__skill.is-active {
    box-shadow: inset 2px 0 0 var(--blue);
  }

  .capability-flight__skill-copy {
    display: grid;
    min-width: 0;
  }

  .capability-flight__skill-copy strong {
    font-size: 0.91rem;
  }

  .capability-flight__skill-copy small {
    overflow: hidden;
    color: var(--ink-faint);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .capability-flight__mini-range {
    display: grid;
    grid-template-columns: repeat(8, 0.22rem);
    gap: 0.16rem;
  }

  .capability-flight__mini-range i {
    width: 0.22rem;
    height: 0.8rem;
    background: var(--line-strong);
    transform: skewX(-14deg);
  }

  .capability-flight__mini-range i.is-reached {
    background: var(--blue);
    box-shadow: 0 0 0.3rem rgba(91, 188, 255, 0.55);
  }

  .capability-flight__scale {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1rem;
    margin-top: 1.4rem;
    color: var(--ink-faint);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.67rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .capability-flight__scale strong {
    margin-right: 0.35rem;
    color: var(--ink);
  }

  @media (max-width: 920px) {
    .capability-flight {
      grid-template-columns: 1fr;
    }

    .capability-flight__skills {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-left: 1px solid var(--line);
    }

    .capability-flight__skill {
      border-right: 1px solid var(--line);
    }
  }

  @media (max-width: 600px) {
    .capability-flight__scene {
      min-height: 24rem;
    }

    .capability-flight__telemetry {
      font-size: 0.58rem;
    }

    .capability-flight__scene-label--orbit {
      top: 51%;
      left: 44%;
    }

    .capability-flight__readout {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .capability-flight__range {
      justify-items: start;
    }

    .capability-flight__readout > p {
      grid-column: 1;
    }

    .capability-flight__controls-heading,
    .capability-flight__skills {
      grid-template-columns: 1fr;
    }

